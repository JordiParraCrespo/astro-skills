{
  "name": "astro-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code skills and agents for building production-grade Astro sites.",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "scan": "node skills/astro/scripts/astro-scan.mjs",
    "dev": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "check": "npm run validate && npm test"
  }
}
