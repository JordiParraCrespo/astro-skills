---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';
---

<BaseLayout title="Not found" noindex>
  <section class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="font-mono text-sm text-[var(--color-accent-fg)]">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">This page is not in the catalog</h1>
    <p class="mt-4 text-[var(--color-fg-muted)]">The skill may have been renamed. Browse the full list instead.</p>
    <a
      href={url('/skills')}
      class="mt-8 inline-flex h-11 items-center rounded-lg bg-[var(--color-primary)] px-5 text-sm font-medium text-[var(--color-primary-fg)]"
      >All skills</a
    >
  </section>
</BaseLayout>
