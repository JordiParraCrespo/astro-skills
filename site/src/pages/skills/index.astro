---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/SkillCard.astro';
import { CATEGORIES } from '../../content.config';
import { CATEGORY_LABELS, url } from '../../lib/site';

const skills = (await getCollection('skills')).sort((a, b) => a.data.metadata.order - b.data.metadata.order);
const agents = (await getCollection('agents')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="All skills"
  description={`All ${skills.length} Astro skills and ${agents.length} audit agents for Claude Code, grouped by category.`}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-24 sm:px-6">
    <p class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent-fg)] uppercase">Catalog</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
      {skills.length} skills. {agents.length} agents.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-fg-muted)]">
      Every skill is a SKILL.md file you can read in full below. Invoke it with its command, or just describe the
      problem and let Claude pick.
    </p>
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Categories">
      {
        CATEGORIES.map((c) => (
          <a
            href={`#${c}`}
            class="rounded-full border border-[var(--color-border)] px-3 py-1 font-mono text-xs transition-colors hover:bg-[var(--color-surface-2)]"
          >
            {CATEGORY_LABELS[c]?.label}
          </a>
        ))
      }
      <a
        href="#agents"
        class="rounded-full border border-[var(--color-border)] px-3 py-1 font-mono text-xs transition-colors hover:bg-[var(--color-surface-2)]"
        >Agents</a
      >
    </nav>

    {
      CATEGORIES.map((cat) => (
        <section class="mt-16" aria-labelledby={cat}>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-[var(--color-border)] pb-3">
            <h2 id={cat} class="font-mono text-sm tracking-widest uppercase">
              {CATEGORY_LABELS[cat]?.label}
            </h2>
            <p class="text-sm text-[var(--color-fg-muted)]">{CATEGORY_LABELS[cat]?.blurb}</p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {skills
              .filter((s) => s.data.metadata.category === cat)
              .map((skill) => (
                <SkillCard skill={skill} />
              ))}
          </div>
        </section>
      ))
    }

    <section class="mt-20" aria-labelledby="agents">
      <div class="border-b border-[var(--color-border)] pb-3">
        <h2 id="agents" class="font-mono text-sm tracking-widest uppercase">Audit agents</h2>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-[var(--color-fg-muted)]">
        Read-only subagents that <a class="underline" href={url('/skills/astro-audit')}>astro-audit</a> runs in parallel.
        Each one applies the checklists of its sub-skills and returns scored findings.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          agents.map((a) => (
            <li class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
              <p class="font-mono text-sm font-semibold">{a.data.name}</p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-fg-muted)]">{a.data.description}</p>
              {a.data.tools && <p class="mt-4 font-mono text-xs text-[var(--color-fg-muted)]">tools: {a.data.tools}</p>}
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</BaseLayout>
