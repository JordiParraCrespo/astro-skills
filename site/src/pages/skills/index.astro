---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/SkillCard.astro';
import { CATEGORIES } from '../../content.config';
import { CATEGORY_LABELS, url } from '../../lib/site';

const skills = (await getCollection('skills')).sort((a, b) => a.data.metadata.order - b.data.metadata.order);
const agents = (await getCollection('agents')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="All skills"
  description={`All ${skills.length} Astro skills and ${agents.length} audit agents for Claude Code, grouped by category.`}
>
  <section class="mx-auto max-w-page px-4 pt-20 pb-24 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
      <div>
        <p class="font-sans text-caption font-semibold tracking-[0.14em] uppercase">The catalog</p>
        <h1 class="mt-4 font-serif font-normal tracking-[-0.025em] text-[44px] leading-[1.04] sm:text-[64px] lg:text-[76px]">
          {skills.length} skills. {agents.length} agents.
        </h1>
      </div>
      <p class="text-body text-pretty lg:pt-10">
        Every skill is a SKILL.md file, printed here in full. Invoke it with its command, or describe the problem and let
        Claude choose.
      </p>
    </div>
    <nav class="mt-12 flex flex-wrap gap-x-6 gap-y-2 border-y border-line py-4 font-sans text-caption" aria-label="Categories">
      {
        CATEGORIES.map((c) => (
          <a href={`#${c}`} class="underline decoration-1 underline-offset-4 hover:decoration-2">
            {CATEGORY_LABELS[c]?.label}
          </a>
        ))
      }
      <a href="#agents" class="underline decoration-1 underline-offset-4 hover:decoration-2">Agents</a>
    </nav>

    {
      CATEGORIES.map((cat) => (
        <section class="mt-16" aria-labelledby={cat}>
          <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-ink pb-3">
            <h2 id={cat} class="font-sans text-caption font-semibold tracking-[0.14em] uppercase">
              {CATEGORY_LABELS[cat]?.label}
            </h2>
            <p class="text-body-sm text-ink-muted">{CATEGORY_LABELS[cat]?.blurb}</p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {skills
              .filter((s) => s.data.metadata.category === cat)
              .map((skill) => (
                <SkillCard skill={skill} />
              ))}
          </div>
        </section>
      ))
    }

    <section class="mt-20 rounded-card bg-panel p-6 sm:p-12" aria-labelledby="agents">
      <p class="font-sans text-caption font-semibold tracking-[0.14em] uppercase">Audit agents</p>
      <h2 id="agents" class="mt-4 font-serif font-normal tracking-[-0.025em] text-4xl leading-[1.1]">Five reviewers, run in parallel</h2>
      <p class="mt-4 max-w-2xl text-body-sm leading-relaxed">
        These read-only subagents are what
        <a class="underline decoration-1 underline-offset-4" href={url('/skills/astro-audit')}>astro-audit</a> sends out.
        Each one applies the checklists of its sub-skills and returns scored findings.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          agents.map((a) => (
            <li class="rounded-card bg-card p-7">
              <p class="font-sans text-[17px] font-semibold tracking-[-0.01em]">{a.data.name}</p>
              <p class="mt-3 text-body-sm leading-relaxed text-ink-muted">{a.data.description}</p>
              {a.data.tools && <p class="mt-5 border-t border-line pt-3 font-mono text-[12px] text-ink-muted">tools: {a.data.tools}</p>}
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</BaseLayout>
