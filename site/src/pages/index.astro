---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillCard from '../components/SkillCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Terminal from '../components/Terminal.astro';
import { RULES } from '../../../skills/astro/scripts/astro-scan.mjs';
import { CATEGORIES } from '../content.config';
import { CATEGORY_LABELS, GITHUB_URL, MANUAL_INSTALL, PLUGIN_INSTALL, SITE_DESCRIPTION, url } from '../lib/site';

const skills = (await getCollection('skills')).sort((a, b) => a.data.metadata.order - b.data.metadata.order);
const agents = await getCollection('agents');
const ruleCount = Object.keys(RULES).length;

const stats = [
  { value: skills.length, label: 'Skills' },
  { value: agents.length, label: 'Audit agents' },
  { value: ruleCount, label: 'Scanner rules' },
  { value: 0, label: 'Runtime deps' },
];

const steps = [
  {
    title: 'Install once',
    body: 'Add the plugin from the marketplace, or clone and run the installer. Skills land in Claude Code, not in your project.',
    code: '/plugin install astro-skills@astro-skills',
  },
  {
    title: 'Ask in plain words',
    body: 'Say "why is my blog slow?" or run a command. Claude loads only the skill that matches, so the context stays lean.',
    code: '/astro perf src/pages/blog',
  },
  {
    title: 'Detect, then decide',
    body: 'A zero-dependency scanner reads your config, version and source first. Every recommendation is anchored on facts, not guesses.',
    code: 'node astro-scan.mjs . --json',
  },
  {
    title: 'Get a plan and a diff',
    body: 'Findings come with file:line, a minimal fix in your code style and a way to verify it worked. Audits fan out to 5 agents in parallel.',
    code: '/astro audit',
  },
];

const workflows = [
  {
    title: 'Starting fresh',
    body: 'Scaffold with production defaults, then set up content and styling the right way from day one.',
    skills: ['astro-init', 'astro-content', 'astro-styling'],
  },
  {
    title: 'Something is off',
    body: 'Slow LCP, layout shift, too much JavaScript or a failing Lighthouse run. Go straight to the specialist.',
    skills: ['astro-perf', 'astro-images', 'astro-islands'],
  },
  {
    title: 'Before a launch',
    body: 'Run the full audit, then close the SEO and accessibility gaps and pick the right deploy target.',
    skills: ['astro-audit', 'astro-seo', 'astro-deploy'],
  },
];

const comparison = [
  ['Knows which Astro major you run', 'Often suggests removed APIs', 'Reads package.json first, verifies APIs'],
  ['Hydration choices', 'client:load everywhere', 'Decision table per island, JS budget'],
  ['Images', 'Raw <img> tags', 'astro:assets, sizes, LCP priority'],
  ['Content', 'Legacy collections', 'Content layer loaders + Zod schemas'],
  ['Findings', 'Vague advice', 'file:line, fix, verification step'],
  ['Audits', 'One long pass', '5 agents in parallel, scored 0–100'],
];

const faqs = [
  {
    q: 'What is a Claude Code skill?',
    a: 'A skill is a folder with a SKILL.md file of focused instructions. Claude Code reads only the short description up front and loads the full skill when your request matches, so you get expert, repeatable workflows without bloating every conversation.',
  },
  {
    q: 'Which Astro versions are supported?',
    a: 'Astro 5 and newer, including the latest major. Every skill starts by reading the installed version and checks APIs against the official docs before recommending them, so it will not push removed APIs like Astro.glob or output: "hybrid".',
  },
  {
    q: 'Does it add anything to my project?',
    a: 'No. The skills live in Claude Code. The scanner is a single Node script with zero dependencies that only reads files. Changes to your project are proposed as minimal diffs you review.',
  },
  {
    q: 'Do I need React, Vue or another UI framework?',
    a: 'No. The skills are framework-agnostic and default to zero JavaScript: native HTML primitives, Astro components and small scripts first. If you already use a UI framework, the islands skill helps you hydrate it responsibly.',
  },
  {
    q: 'How is the audit scored?',
    a: `The scanner checks ${ruleCount} rules across architecture, performance, SEO, accessibility and security. Each rule has a severity weight (critical 15, high 8, medium 3, low 1), capped so one noisy rule cannot sink the score. The agents then add findings the scanner cannot see.`,
  },
  {
    q: 'Can I use it with other agents?',
    a: 'Yes. Skills are plain Markdown, so any agent that supports the SKILL.md format can load them. The installer also works without the plugin marketplace.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Astro Skills',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description: SITE_DESCRIPTION,
  url: new URL(url('/'), Astro.site).href,
  codeRepository: GITHUB_URL,
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto max-w-page px-4 pt-20 pb-16 sm:px-8 lg:pt-28">
    <div class="grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
      <h1 class="font-sans text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-heading">
        {skills.length} skills that turn Claude into an{' '}
        <a href="https://docs.astro.build" class="underline decoration-2 underline-offset-[6px]">Astro</a> engineer.
      </h1>
      <div class="lg:pt-3">
        <p class="text-body text-pretty">
          Audits, islands, content collections, i18n, SEO, images, performance, accessibility and upgrades. Each one
          is a focused <a href={url('/skills')} class="underline decoration-1 underline-offset-4">skill</a> that reads
          your project before it touches it, and hands back fixes you can verify.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 font-sans">
          <a
            href="#install"
            class="rounded-lg bg-action px-8 py-3 text-body-sm font-semibold text-ink transition-colors hover:bg-action-hover"
            >Install the plugin</a
          >
          <a href={url('/skills')} class="text-body-sm underline decoration-1 underline-offset-4 hover:decoration-2"
            >Browse all skills →</a
          >
        </div>
      </div>
    </div>

    <dl class="mt-16 grid grid-cols-2 border-t border-line font-sans sm:grid-cols-4">
      {
        stats.map((s, i) => (
          <div class:list={['py-6 pr-4', i > 0 && 'sm:border-l sm:border-line sm:pl-6', i % 2 === 1 && 'border-l border-line pl-6 sm:pl-6', i >= 2 && 'border-t border-line sm:border-t-0']}>
            <dt class="text-caption text-ink-muted">{s.label}</dt>
            <dd class="mt-1 text-4xl font-bold tabular-nums">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-4 grid items-center gap-10 rounded-card bg-feature p-6 sm:p-12 lg:grid-cols-[1fr_1.35fr] lg:gap-16 [&>*]:min-w-0">
      <div>
        <p class="font-sans text-caption font-semibold tracking-[0.14em] uppercase">Field notes</p>
        <p class="mt-4 text-3xl leading-tight text-balance sm:text-[40px]">
          One command reads the project, sends out five reviewers, and returns a score you can defend.
        </p>
        <p class="mt-6 text-body-sm leading-relaxed text-ink-muted">
          <code class="font-mono text-[15px] text-ink">/astro audit</code> runs a deterministic scanner first, then
          architecture, performance, SEO, accessibility and security agents in parallel.
        </p>
      </div>
      <Terminal />
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-page px-4 py-24 sm:px-8" aria-labelledby="how-it-works">
    <SectionHeading eyebrow="How it works" title="From question to verified fix" id="how-it-works">
      Skills are short, focused playbooks. Claude picks the right one, grounds it in your real project, and hands back
      changes you can check.
    </SectionHeading>
    <ol class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 [&>*]:min-w-0">
      {
        steps.map((s, i) => (
          <li class="flex flex-col rounded-card border border-line bg-card p-7">
            <span class="font-sans text-caption text-ink-muted tabular-nums">Step {i + 1}</span>
            <h3 class="mt-4 font-sans text-subheading font-semibold">{s.title}</h3>
            <p class="mt-3 flex-1 text-body-sm leading-relaxed">{s.body}</p>
            <code class="mt-6 block truncate border-t border-line pt-4 font-mono text-[13px] text-ink-muted">{s.code}</code>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Skills -->
  <section class="border-t border-line" aria-labelledby="skills">
    <div class="mx-auto max-w-page px-4 py-24 sm:px-8">
      <SectionHeading eyebrow="The catalog" title="A specialist for every part of an Astro site" id="skills">
        Every skill has a workflow, code examples, a checklist and the common mistakes to avoid. Invoke one directly or
        let <code class="font-mono text-[17px]">/astro</code> route for you.
      </SectionHeading>
      {
        CATEGORIES.map((cat) => {
          const group = skills.filter((s) => s.data.metadata.category === cat);
          if (!group.length) return null;
          return (
            <div class="mt-16">
              <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-ink pb-3">
                <h3 class="font-sans text-caption font-semibold tracking-[0.14em] uppercase">
                  {CATEGORY_LABELS[cat]?.label}
                </h3>
                <p class="text-body-sm text-ink-muted">{CATEGORY_LABELS[cat]?.blurb}</p>
              </div>
              <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {group.map((skill) => (
                  <SkillCard skill={skill} />
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Workflows -->
  <section class="border-t border-line bg-panel" aria-labelledby="workflows">
    <div class="mx-auto max-w-page px-4 py-24 sm:px-8">
      <SectionHeading eyebrow="Choose a workflow" title="Not sure where to start?" id="workflows">
        Pick the situation that sounds like yours. Each path chains three skills in the order that pays off fastest.
      </SectionHeading>
      <div class="mt-14 grid gap-4 md:grid-cols-3">
        {
          workflows.map((w) => (
            <div class="rounded-card bg-card p-7">
              <h3 class="font-sans text-subheading font-semibold">{w.title}</h3>
              <p class="mt-3 text-body-sm leading-relaxed">{w.body}</p>
              <ol class="mt-6 border-t border-line font-sans">
                {w.skills.map((name, i) => (
                  <li class="border-b border-line">
                    <a href={url(`/skills/${name}`)} class="flex items-baseline gap-3 py-3 text-body-sm hover:underline">
                      <span class="text-caption text-ink-muted tabular-nums">{i + 1}</span>
                      {name}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sample output -->
  <section class="mx-auto max-w-page px-4 py-24 sm:px-8" aria-labelledby="sample">
    <SectionHeading eyebrow="Sample output" title="Scores you can defend, fixes you can verify" id="sample">
      <code class="font-mono text-[17px]">/astro audit</code> writes an
      <code class="font-mono text-[17px]">ASTRO-AUDIT.md</code> with an overall score, a score per category and a priority
      matrix. Every finding names its file and line, and says how you would know the fix failed.
    </SectionHeading>
    <div class="mt-14 rounded-card border border-line bg-card p-6 sm:p-10">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink pb-4 font-sans">
        <p class="text-caption font-semibold tracking-[0.14em] uppercase">ASTRO-AUDIT.md</p>
        <p class="text-caption text-ink-muted">astro ^5.14 · static · 38 pages</p>
      </div>
      <div class="grid grid-cols-3 border-b border-line font-sans sm:grid-cols-6">
        {
          [
            ['Overall', 72],
            ['Architecture', 86],
            ['Performance', 61],
            ['SEO', 70],
            ['Accessibility', 78],
            ['Security', 94],
          ].map(([label, value], i) => (
            <div class:list={['py-6', i % 3 !== 0 && 'border-l border-line pl-4', i === 3 && 'sm:border-l sm:pl-4']}>
              <p class:list={['text-4xl tabular-nums', i === 0 ? 'font-bold' : 'font-normal']}>{value}</p>
              <p class="mt-1 truncate text-caption text-ink-muted">{label}</p>
            </div>
          ))
        }
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] text-left font-sans text-body-sm">
          <thead class="text-caption text-ink-muted">
            <tr class="border-b border-line">
              <th class="py-3 pr-4 font-normal">Priority</th>
              <th class="py-3 pr-4 font-normal">Finding</th>
              <th class="py-3 pr-4 font-normal">Effort</th>
              <th class="py-3 font-normal">Impact</th>
            </tr>
          </thead>
          <tbody>
            {
              [
                ['Critical', 'Hero image lazy-loaded (LCP 4.1s)', 'S', 'L'],
                ['High', '3 islands use client:load below the fold', 'S', 'M'],
                ['High', 'No canonical or hreflang on /es/ routes', 'M', 'L'],
                ['Quick win', 'Add robots.txt endpoint with sitemap', 'S', 'S'],
              ].map(([p, f, e, i]) => (
                <tr class="border-b border-line last:border-0">
                  <td class:list={['py-3.5 pr-4', p === 'Critical' && 'font-semibold']}>{p}</td>
                  <td class="py-3.5 pr-4 font-serif">{f}</td>
                  <td class="py-3.5 pr-4 tabular-nums">{e}</td>
                  <td class="py-3.5 tabular-nums">{i}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="border-t border-line" aria-labelledby="compare">
    <div class="mx-auto max-w-page px-4 py-24 sm:px-8">
      <SectionHeading eyebrow="Why skills" title="A generalist, or a specialist who read your code" id="compare">
        A general coding assistant knows Astro across many versions. These skills make it check the version and code you
        actually have.
      </SectionHeading>
      <div class="mt-14 overflow-x-auto">
        <table class="w-full min-w-[680px] text-left">
          <thead class="font-sans text-caption">
            <tr class="border-b border-ink">
              <th scope="col" class="py-3 pr-6 font-normal text-ink-muted">Topic</th>
              <th scope="col" class="py-3 pr-6 font-normal text-ink-muted">Without skills</th>
              <th scope="col" class="py-3 font-semibold">With Astro Skills</th>
            </tr>
          </thead>
          <tbody class="text-body-sm">
            {
              comparison.map(([topic, before, after]) => (
                <tr class="border-b border-line">
                  <th scope="row" class="py-4 pr-6 font-sans font-semibold">
                    {topic}
                  </th>
                  <td class="py-4 pr-6 text-ink-muted">{before}</td>
                  <td class="py-4">{after}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section class="border-t border-line bg-card" aria-labelledby="install">
    <div class="mx-auto max-w-page px-4 py-24 sm:px-8">
      <SectionHeading eyebrow="Install" title="Ready in under a minute" id="install">
        You need Claude Code, plus Node 18 or newer for the scanner. Nothing is added to your Astro project.
      </SectionHeading>
      <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2 [&>*]:min-w-0">
        <div>
          <h3 class="mb-3 font-sans text-body-sm font-semibold">
            Plugin marketplace <span class="font-normal text-ink-muted">· recommended</span>
          </h3>
          <CopyCommand lines={PLUGIN_INSTALL} label="Claude Code" />
        </div>
        <div>
          <h3 class="mb-3 font-sans text-body-sm font-semibold">
            Manual install <span class="font-normal text-ink-muted">· macOS, Linux</span>
          </h3>
          <CopyCommand lines={MANUAL_INSTALL} label="bash" />
        </div>
        <div class="lg:col-span-2">
          <h3 class="mb-3 font-sans text-body-sm font-semibold">Then, inside any Astro project</h3>
          <CopyCommand lines={['claude', '/astro audit']} label="Your project" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line" aria-labelledby="faq">
    <div class="mx-auto grid max-w-page gap-10 px-4 py-24 sm:px-8 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div>
        <p class="font-sans text-caption font-semibold tracking-[0.14em] uppercase">FAQ</p>
        <h2 id="faq" class="mt-4 font-sans text-4xl font-bold tracking-tight sm:text-5xl">Questions, answered</h2>
      </div>
      <div class="border-t border-ink">
        {
          faqs.map((f) => (
            <details name="faq" class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-sans text-body-sm font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span aria-hidden="true" class="text-subheading font-normal transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="pb-6 text-body-sm leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="mx-auto max-w-page px-4 pb-24 sm:px-8">
    <div class="rounded-card bg-panel px-6 py-16 sm:px-16">
      <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
        <h2 class="text-4xl leading-tight text-balance sm:text-display">
          Build Astro sites as if a specialist were reviewing every change.
        </h2>
        <div>
          <p class="text-body-sm leading-relaxed">
            Open source, MIT licensed, and written in plain Markdown you can read, fork and extend.
          </p>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 font-sans">
            <a href={url('/skills')} class="rounded-b-lg bg-card px-8 py-3 text-body-sm font-medium transition-colors hover:bg-ivory-medium"
              >Read the skills</a
            >
            <a href={GITHUB_URL} class="self-center text-body-sm underline decoration-1 underline-offset-4 hover:decoration-2"
              >Star on GitHub →</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
