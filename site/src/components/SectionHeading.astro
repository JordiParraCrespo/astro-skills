---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id } = Astro.props;
---

<div class="max-w-2xl">
  <p class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent-fg)] uppercase">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
  <div class="mt-4 text-[var(--color-fg-muted)] text-pretty"><slot /></div>
</div>
