---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/site';

interface Props {
  skill: CollectionEntry<'skills'>;
}
const { skill } = Astro.props;
const { metadata } = skill.data;
---

<a
  href={url(`/skills/${skill.id}`)}
  class="group flex h-full flex-col rounded-card border border-line bg-card p-7 transition-colors hover:border-line-strong"
>
  <div class="flex items-baseline justify-between font-sans text-caption text-ink-muted">
    <span class="tabular-nums">{String(metadata.order).padStart(2, '0')}</span>
    <span class="font-semibold tracking-[0.08em] uppercase">{metadata.category}</span>
  </div>
  <h3 class="mt-6 font-sans text-subheading font-semibold">{skill.data.name}</h3>
  <p class="mt-3 flex-1 text-body-sm leading-relaxed text-ink-muted">{metadata.tagline}</p>
  <code class="mt-6 block truncate font-mono text-[13px] text-ink-muted">{metadata.command}</code>
  <span class="mt-5 font-sans text-body-sm underline decoration-1 underline-offset-4 group-hover:decoration-2"
    >Read the skill →</span
  >
</a>
