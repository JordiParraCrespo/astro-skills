---
interface Props {
  lines: string[];
  label?: string;
}
const { lines, label = 'Terminal' } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-term-bg)]">
  <div class="flex items-center justify-between border-b border-[var(--color-border)] px-4 py-2">
    <span class="font-mono text-xs text-[var(--color-term-muted)]">{label}</span>
    <button
      type="button"
      data-copy={lines.join('\n')}
      class="rounded px-2 py-1 font-mono text-xs text-[var(--color-term-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-term-fg)]"
      >Copy</button
    >
  </div>
  <pre
    class="overflow-x-auto px-4 py-4 font-mono text-sm leading-7 text-[var(--color-term-fg)]"><code>{lines.map((l) => <div><span class="text-[var(--color-accent)] select-none">$ </span>{l}</div>)}</code></pre>
</div>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    } catch {
      btn.textContent = 'Select & copy';
    }
  });
</script>
