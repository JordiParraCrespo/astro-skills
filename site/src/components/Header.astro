---
import Logo from './Logo.astro';
import { GITHUB_URL, url } from '../lib/site';

const links = [
  { href: url('/#how-it-works'), label: 'How it works' },
  { href: url('/skills'), label: 'Skills' },
  { href: url('/#install'), label: 'Install' },
  { href: url('/#faq'), label: 'FAQ' },
];
---

<header
  class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_80%,transparent)] backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
    <a href={url('/')} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <Logo class="size-7" />
      <span>astro-skills</span>
    </a>
    <ul class="ml-auto hidden items-center gap-6 text-sm text-[var(--color-fg-muted)] md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-[var(--color-fg)]">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-md border border-[var(--color-border)] text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)]"
        aria-label="Toggle light mode"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>
      <a
        href={GITHUB_URL}
        class="inline-flex h-9 items-center gap-2 rounded-md bg-[var(--color-primary)] px-3 text-sm font-medium text-[var(--color-primary-fg)] transition-opacity hover:opacity-90"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </nav>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const light = document.documentElement.classList.toggle('light');
    try {
      localStorage.setItem('theme', light ? 'light' : 'dark');
    } catch {}
  });
</script>
