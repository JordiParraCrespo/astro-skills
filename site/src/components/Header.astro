---
import Logo from './Logo.astro';
import { GITHUB_URL, url } from '../lib/site';

const links = [
  { href: url('/#how-it-works'), label: 'How it works' },
  { href: url('/skills'), label: 'Skills' },
  { href: url('/#install'), label: 'Install' },
  { href: url('/#faq'), label: 'FAQ' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas">
  <nav class="mx-auto flex h-16 max-w-page items-center gap-8 px-4 font-sans sm:px-8" aria-label="Main">
    <a href={url('/')} class="flex items-center gap-2 text-caption font-bold tracking-[0.14em] uppercase">
      <Logo class="size-5" />
      Astro Skills
    </a>
    <ul class="ml-auto hidden items-center gap-7 text-caption md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="text-ink-muted transition-colors hover:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={GITHUB_URL}
      class="ml-auto rounded-b-lg bg-card px-5 py-2.5 text-caption font-medium tracking-normal transition-colors hover:bg-panel md:ml-0"
      >View on GitHub</a
    >
  </nav>
</header>
